{
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-pdf",
      "command": "C:/texlive/2026/bin/windows/latexmk.exe",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-synctex=1",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk-xelatex",
      "command": "C:/texlive/2026/bin/windows/latexmk.exe",
      "args": [
        "-xelatex",
        "-interaction=nonstopmode",
        "-synctex=1",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk-xelatex",
      "tools": [
        "latexmk-xelatex"
      ]
    },
    {
      "name": "latexmk-pdf",
      "tools": [
        "latexmk-pdf"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "latexmk-xelatex"
}
